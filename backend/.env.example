# Server Port
PORT=5000

# MongoDB Connection String
MONGO_DB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/chat-app-db?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Environment ('development' or 'production')
NODE_ENV=development

# Allowed Frontend URL for CORS (in production, set this to your Cloudflare Pages URL e.g. https://your-chat-app.pages.dev)
FRONTEND_URL=http://localhost:3000
